# Sepolia TESTNET only. Wallet that pays gas for guest players ("Play now"). Leave empty to disable the drip.
DRIP_PRIVATE_KEY=
# optional
DRIP_AMOUNT_ETH=0.0002
DRIP_DAILY_BUDGET_ETH=0.02
# comma-separated frontend origins for CORS and the WebSocket Origin check, e.g. https://deep-secret.vercel.app
ALLOWED_ORIGIN=*
# header your host sets with the real client IP (fly-client-ip, cf-connecting-ip); default: right-most X-Forwarded-For
CLIENT_IP_HEADER=
GAME_ADDRESS=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
